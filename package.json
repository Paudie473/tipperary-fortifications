      "src/models/json/**/*.json"
    ]
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/cookie": "^12.0.1",
    "@hapi/hapi": "^21.4.12",
    "@hapi/inert": "^7.1.3",
    "@hapi/vision": "^7.0.3",
    "dotenv": "^18.0.9",
    "handlebars": "^4.7.10",
    "hapi-swagger": "^17.3.2",
    "joi": "^18.3.1",
    "lowdb": "^7.0.1",
    "mongoose": "^9.11.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "axios": "^1.21.0",
    "chai": "^6.3.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
