  "description": "Website to capture location and information about castles and other fortifications in County Tipperary",
  "license": "ISC",
  "author": "Páidí Ryan",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --exec npm start",
