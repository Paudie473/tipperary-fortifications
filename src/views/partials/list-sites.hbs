{{#each sites}}
  <div class="box box-link-hover-shadow">
    <h2 class="title">
      {{name}}
    </h2>
    <h3 class="subtitle">
      {{address}}
    </h3>
    <a href="/site/{{_id}}" class="button">
      <span class="icon is-small">
        <i class="fab fa-fort-awesome"></i>
      </span>
    </a>
  </div>
{{/each}}