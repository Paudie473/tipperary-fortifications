{{#each users}}
  <div class="box box-link-hover-shadow">
    <h2 class="title">
      {{firstName}} {{lastName}}
    </h2>
    <h3 class="subtitle">
      {{email}}
    </h3>
    <a href="/deleteuser/{{_id}}" class="button">
      <span class="icon is-small">
        <i class="fas fa-trash"></i>
      </span>
    </a>
  </div>
{{/each}}