<form action="/addsite" method="POST">
  <div class="field">
    <label class="label">Structure name</label> <input class="input" type="text" placeholder="Enter structure name" name="name">
  </div>
  <div class="field">
    <label class="label">Address</label> <input class="input" type="text" placeholder="Enter address" name="address">
  </div>
  <div class="field">
    <label class="label">Site Type:</label>
    <div class="select is-fullwidth">
      <select name="type">
        <option value="" disabled selected>Select the option that best describes the site's primary historical purpose...</option>
        <option value="Castle">Castle</option>
        <option value="Royal Site">Royal Site</option>
        <option value="Ecclesiastical Site">Ecclesiastical Site</option>
        <option value="Monastic Site">Monastic Site</option>
        <option value="Manor / Fortified Residence">Manor / Fortified Residence</option>
        <option value="Tower">Tower</option>
        <option value="Fortified Settlement">Fortified Settlement</option>
        <option value="Other">Other</option>
      </select>
    </div>
  </div>
  <label class="label">Coordinates</label>
  <div class="field is-horizontal">
    <input class="input" type="number" placeholder="Lattitude" name="lat" step="any">
    <input class="input" type="number" placeholder="Longitude" name="long" step="any">
  </div>
  <div class="field">
    <label class="label">Description</label>
    <textarea class="textarea" type="text" placeholder="Provide a description of the site" name="description"></textarea>
  </div>
  <button class="button is-link">Add Site</button>
</form>