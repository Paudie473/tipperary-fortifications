<form class="box" action="/site/{{site._id}}/addfeature" method="POST">
  <label>Enter Feature Details:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <input class="input" type="text" placeholder="Feature" name="name">
      </div>
      <div class="field">
        <input class="input" type="text" placeholder="Feature Description" name="description">
      </div>
    </div>
  </div>
  <button class="button is-primary">Add Feature</button>
</form>