<form class="box" action="/site/{{site._id}}/addfeature" method="POST">
  <label class="label">Enter Feature Details:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <input class="input" type="text" placeholder="Feature" name="featureType">
      </div>
      <div class="field">
        <input class="input" type="text" placeholder="Feature Description" name="description">
      </div>
    </div>
  </div>
  <button class="button has-background-warning">Add Feature</button>
</form>