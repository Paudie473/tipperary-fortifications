<section class="section pt-4 pb-0">
  <form action="/dashboard" method="GET">
    <div class="field">
      <label class="label">Filter by category</label>
      <div class="field has-addons">
        <div class="control is-expanded">
          <div class="select is-fullwidth">
            <select id="site-type" name="type" data-filter="{{filter}}">
              <option value="" disabled selected>All Categories</option>
              <option value="Castle">Castle</option>
              <option value="Royal Site">Royal Site</option>
              <option value="Ecclesiastical Site">Ecclesiastical Site</option>
              <option value="Monastic Site">Monastic Site</option>
              <option value="Manor / Fortified Residence">Manor / Fortified Residence</option>
              <option value="Tower">Tower</option>
              <option value="Fortified Settlement">Fortified Settlement</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="control">
          <button class="button has-background-warning" type="submit">Filter</button>
        </div>
        <div class="control">
          <a class="button" href="/dashboard">Clear</a>
        </div>
      </div>
    </div>
  </form>
</section>

<script>
    document.getElementById("site-type").value = document.getElementById("site-type").dataset.filter;
</script>