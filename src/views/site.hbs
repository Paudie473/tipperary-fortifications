{{> menu}}

<!-- Checks if user can edit page and will either give a page where things can be added and deleted or just a readable page -->
{{#if canEdit}}
  <section class="section columns is-vcentered">
    <section class="column section">
      <div class="block">
        <h1 class="title">
            {{site.name}}
        </h1>
        <h2 class="subtitle">{{site.address}}</h2>
        <span class="tag"> Category: {{site.type}} </span>
      </div>
      <div class="content block is-small">
        <p>
            Coordinates: {{site.lattitude}},{{site.longitude}}
        </p>
      </div>
      <div class="content block">
        <h3>Description</h3>
        <p>
            {{site.description}}
        </p>
      </div>
      {{> list-features-deletable}}
      {{> add-feature}}
    </section>
    <div class="column">
      {{> site-image }}
    </div>
  </section>
{{else}}
  <section class="section columns is-vcentered">
    <section class="column section">
      <div class="block">
        <h1 class="title">
            {{site.name}}
        </h1>
        <h2 class="subtitle">{{site.address}}</h2>
        <span class="tag"> Category: {{site.type}} </span>
      </div>
      <div class="content block is-small">
        <p>
            Coordinates: {{site.lattitude}},{{site.longitude}}
        </p>
      </div>
      <div class="content block">
        <h3>Description</h3>
        <p>
            {{site.description}}
        </p>
      </div>
      {{> list-features}}
    </section>
    <div class="column">
      <div class="card">
        <!-- A whole new partian is not needed for this. We only need to show the image if the user cannot edit and only if there is one already there -->
        {{#if hasImg}}
          <div class="card-image">
            <figure class="image is-256x256">
              <img src={{site.img}}>
            </figure>
          </div>
        {{/if}}
    </div>
  </section>
{{/if}}